  "body": "<!DOCTYPE html>\n\n<html lang=en-US>\n\n<head>\n\t<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=2.0\">\n<meta name=\"referrer\" content=\"same-origin\">\n<meta name=\"format-detection\" content=\"date=no\">\n<meta name=\"description\" content=\"Schedule your appointment online Zuma&#039;s \" />\n<meta property=\"fb:app_id\" content=\"465400520261032\" />\n<meta property=\"og:type\" content=\"website\" />\n<meta property=\"og:url\" content=\"\" /><meta property=\"og:title\" content=\"Zuma&#039;s \" />\n<meta name=\"fb:extensions:title\" content=\"Zuma&#039;s \" />\n<meta property=\"og:description\" content=\"Schedule your appointment online Zuma&#039;s \" />\n<meta property=\"og:image\" content=\"https://cdn-s.acuityscheduling.com/logo29763545.png?1747744494&whiteBg=1\" /><meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:url\" content=\"https://app.acuityscheduling.com/schedule.php?owner=29763545\" /><meta name=\"twitter:title\" content=\"Zuma&#039;s \" />\n<meta name=\"twitter:description\" content=\"Schedule your appointment online Zuma&#039;s \" />\n<meta name=\"fb:extensions:title\" content=\"Choose Appointment\" />\n\t<title>Schedule Appointment with Zuma&#039;s </title>\n\t<link rel=\"canonical\" href=\"https://app.acuityscheduling.com/schedule.php?owner=29763545\">\n\t<link rel=\"stylesheet\" href=\"/built/csp/secondo-system-fonts.css\" />\n\t\n\t<script>\n\t\tvar OWNER_KEY = 'fc33f127';\n\t\tvar BUSINESS = {\"id\":29763545,\"ownerKey\":\"fc33f127\",\"billingLevel\":\"Powerhouse\",\"smsRegistrationStatus\":\"completed\",\"color\":\"#03989e\",\"currencySymbol\":\"$\",\"currencyAbbreviation\":\"USD\",\"name\":\"Zuma's \",\"description\":\"<p>Please book your education classes with Zuma's. Your participation is funding the sanctuary herd residing at Zuma's. All changes requires a 48 hour notice to change appointments<\\/p>\",\"url\":\"https:\\/\\/app.acuityscheduling.com\\/schedule.php?owner=29763545\",\"prettyUrl\":\"https:\\/\\/zumasbookingpage.as.me\\/\",\"logoUrl\":\"https:\\/\\/cdn-s.acuityscheduling.com\\/logo29763545.png?1747744494&whiteBg=1\",\"enableClassQuantity\":true,\"hideAnyAvailable\":false,\"hideSpotsClasses\":true,\"hideSpotsServices\":true,\"hidePoweredBy\":false,\"hidePrice\":false,\"hideDuration\":false,\"disableRecurring\":false,\"enableTipping\":false,\"isRequiredClientPhoneForAppointment\":true,\"defaultToClientTimezone\":false,\"clientCanEditTimezone\":false,\"canClientsReschedule\":false,\"canClientsCancel\":true,\"showBusinessName\":true,\"isIntegratedSquarespace\":true,\"collapseCategories\":true,\"allowCheckingPackageCodes\":true,\"disableRegistration\":true,\"isHipaa\":false,\"allowCodeRedemptionWithoutPayment\":true,\"initiallyAppliedCertificateCode\":null,\"hideCalendarName\":false,\"showFullAppointmentDescriptions\":true,\"showAllAddOns\":true,\"businessContext\":\"\",\"appointmentTypeContext\":{},\"isPaypalCompleteOnboarded\":false,\"isWaitlistEnabled\":false,\"planSupportsSms\":true,\"productsDisplayType\":\"2\",\"catalogUrl\":\"https:\\/\\/app.acuityscheduling.com\\/catalog.php?owner=29763545\",\"products\":{\"Packages\":[{\"id\":2280791,\"title\":\" Tiny Tot Lesson Package\",\"description\":\"Includes eight age-appropriate Tiny Tot lessons introducing young riders to horses in a safe and fun environment. Lessons focus on confidence, balance, basic horse handling, and introductory riding skills.\",\"price\":320,\"formattedPrice\":\"$320.00\",\"category\":\"\",\"thumbnailUrl\":null,\"isSubscription\":false,\"subscriptionTermsText\":\"\"},{\"id\":2280806,\"title\":\"Advanced Canter\\/Jumping Class: must be approved to schedule this\",\"description\":\"Includes four jumping lessons for riders who have established the necessary walk, trot, and canter skills. Lessons may focus on position, balance, pole work, course patterns, and safe jumping technique. Instructor approval required.\",\"price\":320,\"formattedPrice\":\"$320.00\",\"category\":\"\",\"thumbnailUrl\":null,\"isSubscription\":false,\"subscriptionTermsText\":\"\"},{\"id\":2280794,\"title\":\"Advanced- Walk\\/Trot\\/Canter Package\",\"description\":\"Includes four advanced riding lessons for riders working at the walk, trot, and canter. Lessons focus on refining balance, transitions, communication, technique, and independent riding skills.\",\"price\":320,\"formattedPrice\":\"$320.00\",\"category\":\"\",\"thumbnailUrl\":null,\"isSubscription\":false,\"subscriptionTermsText\":\"\"},{\"id\":2280792,\"title\":\"Beginner Walk Only Package \",\"description\":\"Includes five beginner riding lessons for riders learning foundational horsemanship and walk-level riding skills. \",\"price\":320,\"formattedPrice\":\"$320.00\",\"category\":\"\",\"thumbnailUrl\":null,\"isSubscription\":false,\"subscriptionTermsText\":\"\"},{\"id\":2280793,\"title\":\"Intermediate (Walk\\/Trot) Package \",\"description\":\"Includes four intermediate riding lessons for riders working at the walk and trot. Lessons focus on balance, control, transitions, effective cues, riding patterns, and increased independence.\",\"price\":320,\"formattedPrice\":\"$320.00\",\"category\":\"\",\"thumbnailUrl\":null,\"isSubscription\":false,\"subscriptionTermsText\":\"\"},{\"id\":2280795,\"title\":\"Western Riding Package- All Levels \",\"description\":\"Includes four Western riding lessons focused on balanced riding, effective cues, horse handling, and Western horsemanship. Appropriate riding level and lesson goals will be determined by the instructor.\",\"price\":320,\"formattedPrice\":\"$320.00\",\"category\":\"\",\"thumbnailUrl\":null,\"isSubscription\":false,\"subscriptionTermsText\":\"\"}],\"Gift Certtificate \":[{\"id\":2093605,\"title\":\"Give the Gift of Horses and Healing \",\"description\":\"If you know someone who loves horses, a gift certificate to Zuma's can be used to sponsor a horse for 5 months, or applied to any of our many education classes. The best part of this gift is that you and your recipient will be supporting the life saving work we have been providing since 2008 \",\"price\":200,\"formattedPrice\":\"$200.00\",\"category\":\"Gift Certtificate \",\"thumbnailUrl\":\"https:\\/\\/cdn-s.acuityscheduling.com\\/product-thumb-2093605.jpg?1763764139\",\"isSubscription\":false,\"subscriptionTermsText\":\"\"}]},\"catalogCheckoutTerms\":\"\",\"calendars\":{\"Zuma's\":[{\"id\":14543372,\"name\":\"Aimee Potter\",\"description\":\"\",\"location\":\"Zuma's\",\"timezone\":\"America\\/Denver\",\"thumbnail\":\"\",\"image\":\"\"},{\"id\":12173015,\"name\":\"Julie\",\"description\":\"Julie comes from the world of horses, specifically the Hunter Jumper world, both as a rider and a coach. \\n\",\"location\":\"Zuma's\",\"timezone\":\"America\\/Denver\",\"thumbnail\":\"\\/\\/cdn-s.acuityscheduling.com\\/calendar-thumb-12173015.jpeg?1783610509\",\"image\":\"\\/\\/cdn-s.acuityscheduling.com\\/calendar-12173015.jpeg?1783610509\"},{\"id\":14469022,\"name\":\"Kate Pearson, LSW\",\"description\":\"Kate is a Licensed Social Worker and had a varied experience working with, adults, children and families.\",\"location\":\"Zuma's\",\"timezone\":\"America\\/Denver\",\"thumbnail\":\"\\/\\/cdn-s.acuityscheduling.com\\/calendar-thumb-14469022.jpg?1787267774\",\"image\":\"\\/\\/cdn-s.acuityscheduling.com\\/calendar-14469022.jpg?1787267774\"},{\"id\":12172999,\"name\":\"Mia Kitner\",\"description\":\"Horsemanship - Rider Evaluations - Tiny Tots\",\"location\":\"Zuma's\",\"timezone\":\"America\\/Denver\",\"thumbnail\":\"\\/\\/cdn-s.acuityscheduling.com\\/calendar-thumb-12172999.jpeg?1778358470\",\"image\":\"\\/\\/cdn-s.acuityscheduling.com\\/calendar-12172999.jpeg?1778358470\"},{\"id\":14056826,\"name\":\"Michelle Stafford \",\"description\":\"Michelle competed successfully at Grand Prix level show jumping in South Africa for many years before emigrating to the USA. After moving to the States, she shifted her focus toward natural horsemanship and became involved in gentling and training Mustangs. Michelle now runs an online horse show platform where riders across the USA can compete in a variety of disciplines. She is passionate about helping riders build confidence, improve their horsemanship, and develop stronger partnerships with their horses.\",\"location\":\"Zuma's\",\"timezone\":\"America\\/Denver\",\"thumbnail\":\"\\/\\/cdn-s.acuityscheduling.com\\/calendar-thumb-14056826.jpeg?1780331432\",\"image\":\"\\/\\/cdn-s.acuityscheduling.com\\/calendar-14056826.jpeg?1780331432\"},{\"id\":12148494,\"name\":\"Misty Perry - Licensed Clinical Social Worker\",\"description\":\"Therapy sessions with Misty Perry \",\"location\":\"Zuma's\",\"timezone\":\"America\\/Denver\",\"thumbnail\":\"\\/\\/cdn-s.acuityscheduling.com\\/calendar-thumb-12148494.jpeg?1753719421\",\"image\":\"\\/\\/cdn-s.acuityscheduling.com\\/calendar-12148494.jpeg?1753719421\"},{\"id\":13945759,\"name\":\"Morgan Ferris\",\"description\":\"Morgan joins us as assistant riding coach, teaching everything from tiny tots and new rider evalutions to beginner & intermediate riding lessons and walk a horse. \",\"location\":\"Zuma's\",\"timezone\":\"America\\/Denver\",\"thumbnail\":\"\\/\\/cdn-s.acuityscheduling.com\\/calendar-thumb-13945759.png?1776958334\",\"image\":\"\\/\\/cdn-s.acuityscheduling.com\\/calendar-13945759.png?1776958334\"},{\"id\":14561137,\"name\":\"Sarah Behen\",\"description\":\"Sarah joins us from a background in both Equestrian and Mental Health, so she will be helping out in both of Zuma's Riding Program and Therapy Program \",\"location\":\"Zuma's\",\"timezone\":\"America\\/Denver\",\"thumbnail\":\"\\/\\/cdn-s.acuityscheduling.com\\/calendar-thumb-14561137.jpeg?1789497250\",\"image\":\"\\/\\/cdn-s.acuityscheduling.com\\/calendar-14561137.jpeg?1789497250\"}],\"\":[{\"id\":\"any\",\"name\":\"Any available\",\"description\":\"\",\"timezone\":\"\",\"location\":\"\",\"thumbnail\":\"\",\"image\":\"\",\"types\":[]}]},\"appointmentTypes\":{\"Equine Education \":[{\"id\":78525101,\"name\":\"Colt Starting\",\"active\":true,\"description\":\"Desensitizing and saddle starting\",\"duration\":60,\"price\":\"60.00\",\"category\":\"Equine Education \",\"color\":\"#FCE77B\",\"private\":false,\"type\":\"service\",\"image\":\"\",\"classSize\":null,\"paddingAfter\":0,\"paddingBefore\":0,\"calendarIDs\":[14056826],\"addonIDs\":[],\"formIDs\":[],\"paymentRequired\":true,\"isOnlinePaymentNotAllowed\":false,\"showSmsOptIn\":true,\"canChooseQuantity\":false,\"smsRemindersEnabled\":true},{\"id\":98000446,\"name\":\"School\\u2019s Out Ranch Days\",\"active\":true,\"description\":\"No school? Spend the day at Zuma\\u2019s Rescue Ranch!\\n\\nOpen to children ages 5\\u201312 who are currently enrolled in Kindergarten or above. Kids will enjoy hands-on horse and animal care, horsemanship and safety lessons, ranch chores, crafts, outdoor games, and plenty of fresh air.\\n\\nCamp runs from 9 AM\\u20131 PM, with optional aftercare from 1\\u20133 PM. \\n\\nRiding may be included depending on weather, horse availability, and safety.\\n\\nQuestions? Email Katepearson1122@gmail.com\",\"duration\":240,\"price\":\"50.00\",\"category\":\"Equine Education \",\"color\":\"#554097\",\"private\":false,\"type\":\"class\",\"image\":\"\",\"classSize\":6,\"paddingAfter\":0,\"paddingBefore\":0,\"calendarIDs\":[14469022],\"addonIDs\":[7285662],\"formIDs\":[],\"paymentRequired\":true,\"isOnlinePaymentNotAllowed\":false,\"showSmsOptIn\":true,\"canChooseQuantity\":true,\"smsRemindersEnabled\":true},{\"id\":98100364,\"name\":\"Equine Wellness Check Class\",\"active\":true,\"description\":\"This is a class designed for true horse lovers, a class designed to teach you all about your horses wellnes\\/soundess for riding. You will learn how to palpate the cervical spine, the neck, and hid quarters. These skills will facilitate a closer relationship with you and the horses you ride in addition to being very beneficial for the horses. We suggest you sign up for these $25 classes once a month, you horses will thank you. \",\"duration\":30,\"price\":\"25.00\",\"category\":\"Equine Education \",\"color\":\"#FCE77B\",\"private\":false,\"type\":\"service\",\"image\":\"\",\"classSize\":null,\"paddingAfter\":0,\"paddingBefore\":0,\"calendarIDs\":[14543372],\"addonIDs\":[],\"formIDs\":[],\"paymentRequired\":true,\"isOnlinePaymentNotAllowed\":false,\"showSmsOptIn\":true,\"canChooseQuantity\":false,\"smsRemindersEnabled\":true},{\"id\":78539409,\"name\":\"Ground Driving Lessons\",\"active\":true,\"description\":\"Learn to drive horses from the ground. Great way to understand steering and accurate rein pressure . \",\"duration\":60,\"price\":\"45.00\",\"category\":\"Equine Education \",\"color\":\"#FCE77B\",\"private\":false,\"type\":\"service\",\"image\":\"\",\"classSize\":null,\"paddingAfter\":0,\"paddingBefore\":0,\"calendarIDs\":[14056826,13945759],\"addonIDs\":[],\"formIDs\":[],\"paymentRequired\":true,\"isOnlinePaymentNotAllowed\":false,\"showSmsOptIn\":true,\"canChooseQuantity\":false,\"smsRemindersEnabled\":true},{\"id\":78663940,\"name\":\"Walk a Horse Lesson\",\"active\":true,\"description\":\"Learn the Basics of Walking a Horse. Join us to build your confidence and skills by learning:\\n\\nHow to halter and lead a horse safely\\nTechniques to prevent bolting or being dragged to graze\\nHow to ground your energy and become a calm, trusted, and effective leader\\nPerfect for new or returning horse lovers who want to build a solid foundation with their equine partner.\",\"duration\":30,\"price\":\"20.00\",\"category\":\"Equine Education \",\"color\":\"#FCE77B\",\"private\":false,\"type\":\"service\",\"image\":\"\",\"classSize\":null,\"paddingAfter\":0,\"paddingBefore\":0,\"calendarIDs\":[12173015,14056826,13945759,14561137],\"addonIDs\":[],\"formIDs\":[],\"paymentRequired\":true,\"isOnlinePaymentNotAllowed\":false,\"showSmsOptIn\":true,\"canChooseQuantity\":false,\"smsRemindersEnabled\":true},{\"id\":78751661,\"name\":\"Horse Training Session\",\"active\":true,\"description\":\"Work one on one with a trainer here at Zuma's to move them along in their training.\",\"duration\":30,\"price\":\"20.00\",\"category\":\"Equine Education \",\"color\":\"#FCE77B\",\"private\":false,\"type\":\"service\",\"image\":\"\",\"classSize\":null,\"paddingAfter\":0,\"paddingBefore\":0,\"calendarIDs\":[12173015,12172999,14056826],\"addonIDs\":[],\"formIDs\":[],\"paymentRequired\":true,\"isOnlinePaymentNotAllowed\":false,\"showSmsOptIn\":true,\"canChooseQuantity\":false,\"smsRemindersEnabled\":true},{\"id\":80530255,\"name\":\"Ranch Tour\",\"active\":true,\"description\":\"Interested in learning about Zuma's? Take a walking tour with a staff member that can answer all of your questions. \",\"duration\":30,\"price\":\"25.00\",\"category\":\"Equine Education \",\"color\":\"#3B8344\",\"private\":false,\"type\":\"service\",\"image\":\"https:\\/\\/cdn-s.acuityscheduling.com\\/appointmentType-80530255.jpeg?1751742260\",\"classSize\":null,\"paddingAfter\":0,\"paddingBefore\":0,\"calendarIDs\":[14469022,13945759,14561137],\"addonIDs\":[],\"formIDs\":[],\"paymentRequired\":true,\"isOnlinePaymentNotAllowed\":false,\"showSmsOptIn\":true,\"canChooseQuantity\":false,\"smsRemindersEnabled\":true},{\"id\":85325027,\"name\":\"Horse Body Clipping\",\"active\":true,\"description\":\"You will learn the how and why we body clip working horses through winter, along with how to best care for your clipped horse! \",\"duration\":60,\"price\":\"50.00\",\"category\":\"Equine Education \",\"color\":\"#B7A6EB\",\"private\":false,\"type\":\"service\",\"image\":\"\",\"classSize\":null,\"paddingAfter\":15,\"paddingBefore\":0,\"calendarIDs\":[14056826],\"addonIDs\":[],\"formIDs\":[],\"paymentRequired\":true,\"isOnlinePaymentNotAllowed\":false,\"showSmsOptIn\":true,\"canChooseQuantity\":false,\"smsRemindersEnabled\":true},{\"id\":78906860,\"name\":\"Horsemanship 101: Gateway to Handling Horses\",\"active\":true,\"description\":\"\",\"duration\":120,\"price\":\"80.00\",\"category\":\"Equine Education \",\"color\":\"#FFE767\",\"private\":false,\"type\":\"class\",\"image\":\"\",\"classSize\":8,\"paddingAfter\":0,\"paddingBefore\":0,\"calendarIDs\":[12172999,14056826,13945759],\"addonIDs\":[],\"formIDs\":[],\"paymentRequired\":true,\"isOnlinePaymentNotAllowed\":false,\"showSmsOptIn\":true,\"canChooseQuantity\":true,\"smsRemindersEnabled\":true}],\"Riding Program \":[{\"id\":78508397,\"name\":\"New Rider Evaluation\",\"active\":true,\"description\":\"Our New Rider Evaluation is designed to help us get to know each rider\\u2019s current experience, comfort level, goals, and safety awareness before placing them in lessons or riding opportunities. All new riders must complete an evaluation before being scheduled for regular riding lessons or lease-related riding opportunities.\",\"duration\":45,\"price\":\"60.00\",\"category\":\"Riding Program \",\"color\":\"#B7A6EB\",\"private\":false,\"type\":\"service\",\"image\":\"\",\"classSize\":null,\"paddingAfter\":15,\"paddingBefore\":0,\"calendarIDs\":[12173015,12172999,14056826,14561137],\"addonIDs\":[],\"formIDs\":[3208353],\"paymentRequired\":true,\"isOnlinePaymentNotAllowed\":false,\"showSmsOptIn\":true,\"canChooseQuantity\":false,\"smsRemindersEnabled\":true},{\"id\":78508419,\"name\":\"Private Beginner Lesson - Walk Only\",\"active\":true,\"description\":\"\",\"duration\":60,\"price\":\"75.00\",\"category\":\"Riding Program \",\"color\":\"#B7A6EB\",\"private\":false,\"type\":\"service\",\"image\":\"\",\"classSize\":null,\"paddingAfter\":0,\"paddingBefore\":0,\"calendarIDs\":[12173015,12172999,14056826,13945759,14561137],\"addonIDs\":[],\"formIDs\":[],\"paymentRequired\":true,\"isOnlinePaymentNotAllowed\":false,\"showSmsOptIn\":true,\"canChooseQuantity\":false,\"smsRemindersEnabled\":true},{\"id\":78508439,\"name\":\"Private Intermediate Lesson - Walk\\/Trot Only\",\"active\":true,\"description\":\"\",\"duration\":60,\"price\":\"80.00\",\"category\":\"Riding Program \",\"color\":\"#B7A6EB\",\"private\":false,\"type\":\"service\",\"image\":\"\",\"classSize\":null,\"paddingAfter\":0,\"paddingBefore\":0,\"calendarIDs\":[12173015,12172999,14056826,13945759,14561137],\"addonIDs\":[],\"formIDs\":[],\"paymentRequired\":true,\"isOnlinePaymentNotAllowed\":false,\"showSmsOptIn\":true,\"canChooseQuantity\":false,\"smsRemindersEnabled\":true},{\"id\":78508447,\"name\":\"Private Advanced Lesson - Walk\\/Trot\\/Canter\",\"active\":true,\"description\":\"\",\"duration\":60,\"price\":\"85.00\",\"category\":\"Riding Program \",\"color\":\"#B7A6EB\",\"private\":false,\"type\":\"service\",\"image\":\"\",\"classSize\":null,\"paddingAfter\":0,\"paddingBefore\":0,\"calendarIDs\":[12173015,14056826],\"addonIDs\":[],\"formIDs\":[],\"paymentRequired\":true,\"isOnlinePaymentNotAllowed\":false,\"showSmsOptIn\":true,\"canChooseQuantity\":false,\"smsRemindersEnabled\":true},{\"id\":78508466,\"name\":\"Private Walk\\/Trot\\/Canter\\/Jump Lesson\",\"active\":true,\"description\":\"\",\"duration\":60,\"price\":\"90.00\",\"category\":\"Riding Program \",\"color\":\"#B7A6EB\",\"private\":false,\"type\":\"service\",\"image\":\"\",\"classSize\":null,\"paddingAfter\":0,\"paddingBefore\":0,\"calendarIDs\":[12173015,14056826],\"addonIDs\":[],\"formIDs\":[],\"paymentRequired\":true,\"isOnlinePaymentNotAllowed\":false,\"showSmsOptIn\":true,\"canChooseQuantity\":false,\"smsRemindersEnabled\":true},{\"id\":78508501,\"name\":\"Tiny Tot Lesson - Children 6 and Under\",\"active\":true,\"description\":\"Time included capturing horse from paddock, grooming, riding, and taking the horse back home. \",\"duration\":30,\"price\":\"45.00\",\"category\":\"Riding Program \",\"color\":\"#B7A6EB\",\"private\":false,\"type\":\"service\",\"image\":\"\",\"classSize\":null,\"paddingAfter\":0,\"paddingBefore\":0,\"calendarIDs\":[12172999,13945759,14561137],\"addonIDs\":[],\"formIDs\":[],\"paymentRequire