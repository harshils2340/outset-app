SEARCHAPI_KEYS=key1,key2
# Neon Postgres (pooled connection string). Profiles, bookings, payouts and the mail list live here; the API refuses to serve without it.
DATABASE_URL=
RESEND_API_KEY=
MAIL_FROM=Harshil <hello@onoutset.com>
MAIL_REPLY_TO=hello@onoutset.com
# Founder inbox for every booking request, with the shop's phone. Unclaimed shops hear from nobody else.
BOOKING_ALERT_EMAIL=
# Claim emails: send from your Gmail so they look like a person. App password, not your login password.
# MAIL_SMTP_USER=harshils2340@gmail.com
# MAIL_SMTP_PASS=
# Real street address on commercial emails (CAN-SPAM / CASL). Required before outreach-send to businesses.
MAIL_POSTAL=
API_URL=https://outset-api.onrender.com
OPENAI_API_KEY=
# or ANTHROPIC_API_KEY=
# Optional overrides:
# OUTSET_EXTRACT_PROVIDER=openai|anthropic
# OUTSET_EXTRACT_MODEL=gpt-4.1

# AI extraction (optional). Paste OPENAI_API_KEY to enable. Budget is a hard cap in dollars across all runs.
OPENAI_API_KEY=
OUTSET_EXTRACT_PROVIDER=openai
OUTSET_EXTRACT_MODEL=gpt-4.1-mini
OUTSET_EXTRACT_BUDGET_USD=20

# TEST ONLY. Leave this out everywhere except a machine you are testing on.
# The addresses named here may claim AND release ANY listing, skipping the check that a claim link
# can only go to the email on that business's own website. Every use prints a "TEST CLAIM BYPASS" line
# in the server log. Unset (the default) means the bypass does not exist: the real rule is the only rule.
# OUTSET_TEST_CLAIM_EMAILS=malharshah200428@gmail.com,harshils2340@gmail.com
# With the bypass on and no mail transport, set SITE_URL so the link points at your dev server:
# SITE_URL=http://localhost:5173/
# Claim LINKS only validate on a host that has the production CLAIM_SECRET, because the token is checked
# against the claimKey the production sync wrote into the catalog. Without it, use the "Open the dashboard
# now" button on the claim screen, which takes a session instead of a link. See AGENTS.md, test-enter.

# Bounce and complaint feedback from Resend. Point a Resend webhook at POST /webhooks/resend and paste its
# signing secret here. Without it that route refuses every event: an endpoint that can suppress an address
# must not be callable by anyone. Hard bounces and spam complaints then stop the next send automatically.
RESEND_WEBHOOK_SECRET=

# GetYourGuide affiliate feed (npx tsx src/index.ts getyourguide). The access token is issued by a GetYourGuide
# Partner Manager (partner.getyourguide.com, no self-service page); the partner id is the one on your
# partner links (partner_id=...). Unset: the command says so and does nothing.
GYG_API_KEY=
GYG_PARTNER_ID=

# How many days a claim link stays good. Default 30. Links are signed over the listing id and this expiry,
# so an old forwarded email stops opening a dashboard.
CLAIM_LINK_DAYS=30

# Klook affiliate feed (src/affiliates/klook.ts). Klook publishes no affiliate content API document; the key
# and its base URL come from the affiliate team (affiliate@klook.com, after joining at affiliate.klook.com).
# AID (affiliate partner id) and WID (website id for onoutset.com) are on the affiliate portal's account
# page and go on every booking link so the click is attributed. Unset: `npx tsx src/index.ts klook` says so
# and does nothing.
KLOOK_API_KEY=
KLOOK_API_BASE=
KLOOK_AID=
KLOOK_WID=
