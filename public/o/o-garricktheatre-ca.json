{"id":"o-garricktheatre-ca","claimKey":"6f64039d42b4c6f76d5848dac3054ff90a502d02066ec8b1126d8c5918e02fef","title":"Garrick Theatre","cat":"play","art":"theatre","area":"Bonavista, NL","metroId":"","src":"garricktheatre.ca","specs":[],"options":[{"name":"Overnight stay","detail":"Tickets","price":25},{"name":"The Penguin Lessons","detail":"","price":null}],"services":[{"name":"Overnight stay","desc":null,"photo":"https://images.squarespace-cdn.com/content/v1/62794c539ef87f72a6840b47/1784736119864-P6WJRJUBYMO5NF0ID09V/Relay+for+Life+Benefit+Concert+%28800+%C3%97+600+px%29.png?format=2500w","variants":[{"label":"Tickets","price":25,"optionIdx":0}]},{"name":"The Penguin Lessons","desc":"Craving a better movie with superior story-telling, exceptional character development, and solid acting and direction? We can help with that! This Summer The Garrick will begin bringing you the best in independent film through a new initiative in partnership with MUN Cinema. Dr. Noreen Golfman, a long time professor of English and administrator at Memorial University who regularly taught film studies, founded both the St. John's International Women's Film Festival (1989) and the MUN Cinema Series (1991). Now retired from Memorial, every Fall and Winter Noreen continues to lead MUN Cinema, presenting a program at St. John's of critically acclaimed, independent films from around the world.","photo":"https://images.squarespace-cdn.com/content/v1/62794c539ef87f72a6840b47/1786020783235-3KUT05CA76H09J58ZV9E/peng+%28800+x+600+px%29.jpg?format=2500w","variants":[{"label":"Standard","price":null,"optionIdx":1}]}],"includes":[],"addons":[],"gap":"Prices, hours and eligibility are not copied here yet. We will ask when you request.","cover":"https://images.squarespace-cdn.com/content/v1/62794c539ef87f72a6840b47/211aec3a-a4aa-4223-9ea4-ab644b7f4bc4/theatre-looking-toward.jpg?format=2500w","photos":["https://images.squarespace-cdn.com/content/v1/62794c539ef87f72a6840b47/211aec3a-a4aa-4223-9ea4-ab644b7