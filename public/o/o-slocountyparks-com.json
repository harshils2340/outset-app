{"id":"o-slocountyparks-com","claimKey":"fca8437f6bf1c3038cd58e3586ea7ec1c5698738dd2feda374a9b7156f911243","title":"Coastal Dunes RV Park","cat":"outdoor","art":"camping","area":"San Luis Obispo, CA","metroId":"","src":"slocountyparks.com","specs":[],"options":[{"name":"Daily Pool Entry - Adult","detail":"Standard","price":5},{"name":"Boat Tours (Adult or Child)","detail":"Standard","price":36},{"name":"2026 Aquatics Program","detail":"Adult 12 Entry Swim Pass","price":50},{"name":"Full hookup - On Season","detail":"Daily","price":64},{"name":"Full hookup - On Season","detail":"Weekend","price":67},{"name":"Full hookup - On Season","detail":"Holiday","price":70},{"name":"Cabins - On Season","detail":"Daily","price":100},{"name":"Cabins - On Season","detail":"Weekend","price":135},{"name":"Cabins - On Season","detail":"Holiday","price":160}],"services":[{"name":"Daily Pool Entry - Adult","desc":null,"photo":"https://slocountyparks.com/wp-content/uploads/2026/07/SM-Hours-Website.png","variants":[{"label":"Standard","price":5,"optionIdx":0}]},{"name":"Boat Tours (Adult or Child)","desc":null,"variants":[{"label":"Standard","price":36,"optionIdx":1}]},{"name":"2026 Aquatics Program","desc":"We are very excited to provide the Cayucos Beach Junior/Discover Lifeguard (CBJG) Program this year. We encourage strong, young swimmers to register for Cayucos Beach Junior Lifeguards (3-week program) or Discover Junior Lifeguards (1-week program). These programs offer a great opportunity for youngsters to spend quality time with United States Lifeguard Association (U.S.L.A.) trained open-water instructors. Cayucos Beach Junior Lifeguards is a 3-week skill-building program with emphasis on healthy exercise, teamwork, rescue training, and FUN! Participants will learn: All Junior Lifeguard sessions meet Monday - Friday from 9:00 a.m. - 2:00 p.m. except for the first Monday (orientation at","photo":"https://slocountyparks.com/wp-content/uploads/2023/02/5E4F3060-ED32-461D-9499-2133704B2204-300x225.jpg","variants":[{"label":"Adult 12 Entry Swim Pass","price":50,"optionIdx":2}]},{"name":"Full hookup - On Season","desc":null,"photo":"https://slocountyparks.com/wp-content/uploads/2026/05/Copy-of-POOL-SEASON-CLOSURE.png","variants":[{"label":"Daily","price":64,"optionIdx":3},{"label":"Weekend","price":67,"optionIdx":4},{"label":"Holiday","price":70,"optionIdx":5}],"explain":[{"term":"Full hookup","meaning":"The site connects your RV to power, water and sewer."}]},{"name":"Cabins - On Season","desc":null,"photo":"https://slocountyparks.com/wp-content/uploads/2026/05/Copy-of-POOL-SEASON-CLOSURE.png","variants":[{"label":"Daily","price":100,"optionIdx":6},{"label":"Weekend","price":135,"optionIdx":7},{"label":"Holiday","price":160,"optionIdx":8}]}],"includes":[],"addons":[],"gap":"Prices, hours and eligibility are not copied here yet. We will ask when you request.","blurb":"San Luis Obispo County Parks has been managing the operations of Coastal Dunes RV Park and Campground since October 1, 2006 and is located along Highway 1 on the scenic Central Coast. The park is conveniently located next to the Grover Beach Amtrak Station, adjacent to the railroad tracks. Throughout the park, there are restrooms, hot shower facilities, and laundromats.","cover":"https://slocountyparks.com/wp-content/uploads/2026/05/IMG_8986-scaled.jpg","photos":["https://slocountyparks.com/wp-content/uploads/2026/05/IMG_8986-scaled.jpg","https://slocountyparks.com/wp-content/uploads/2026/05/IMG_8977-scaled.jpg","https://slocountyparks.com/wp-content/uploads/2026/05/IMG_8984-scaled.jpg","https://slocountyparks.com/wp-content/uploads/2026/05/IMG_8978-scaled.jpg","https://slocountyparks.com/wp-content/uploads/2026/05/IMG_8980-scaled.jpg","https://slocountyparks.com/wp-content/uploads/2026/05/IMG_8982-scaled.jpg","https://slocountyparks.com/wp-content/uploads/2026/05/IMG_8989-scaled.jpg","https://slocountyparks.com/wp-content/uploads/2026/05/IMG_8974-scaled.jpg"],"ytVideos":[],"lat":35.11