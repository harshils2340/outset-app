{"id":"o-madisoncountyal-gov","claimKey":"ac19682b7d8dded18b73be7bfd02b9dadb44d55d049f57ead6a70e2ba62d6da3","title":"Sharon Johnston Campground","cat":"outdoor","art":"camping","area":"Nashville, AL","metroId":"","src":"madisoncountyal.gov","specs":[],"options":[{"name":"Campsite","detail":"RUSTIC SITE","price":25},{"name":"Campsite","detail":"MODERN/SEPTIC SITE","price":35},{"name":"Shooting Range","detail":"","price":null},{"name":"Small Claims Court","detail":"","price":null},{"name":"Disc Golf Course","detail":"","price":null},{"name":"fishing rodeo","detail":"","price":null},{"name":"Renew Tour Tag Online","detail":"","price":null}],"services":[{"name":"Campsite","desc":null,"photo":"https://www.madisoncountyal.gov/home/showpublishedimage/3902/636958673750370000","variants":[{"label":"RUSTIC SITE","price":25,"optionIdx":0},{"label":"MODERN/SEPTIC SITE","price":35,"optionIdx":1}]},{"name":"Shooting Range","desc":"Thank you for the interest in the Madison County Shooting Sports Association (MCSSA). We are located on Coleman Road in New Market, Alabama gate 4 of Sharon Johnston Park. We are open to the public most weekends from 9 a.m. till 3 p.m. Some exceptions to this are the weekends after Thanksgiving, Christmas and New Years and when we are closed for maintenance. The club does not sell ammunition or rent firearms. All transactions at the range are done with cash or personal check, no credit or debit cards accepted. Please contact David A. Lampkin, Madison County Shooting Sports Association","photo":"https://www.madisoncountyal.gov/home/showpublishedimage/5711/639203988081630000","variants":[{"label":"Standard","price":null,"optionIdx":2}]},{"name":"Small Claims Court","desc":null,"variants":[{"label":"Standard","price":null,"optionIdx":3}]},{"name":"Disc Golf Course","desc":null,"photo":"https://www.madisoncountyal.gov/home/showpublishedimage/5699/639203988064100000","variants":[{"label":"Standard","price":null,"optionIdx":4}]},{"name":"fishing rodeo","desc"