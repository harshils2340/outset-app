{"id":"o-wnpa-org","claimKey":"fb43ae3f976a7d2e99bd9eef299d5407dfdf1b6420573cdbb7eca0e4cb8f8c50","title":"Hubbel Trading Post and Museum","cat":"play","art":"museum","area":"AZ","metroId":"","src":"wnpa.org","specs":[],"options":[{"name":"Rock climbing","detail":"","price":null},{"name":"Wildlife viewing","detail":"","price":null},{"name":"Overnight stay","detail":"","price":null},{"name":"Campsite","detail":"","price":null},{"name":"Daily Cave Tours","detail":"","price":null},{"name":"Drop in Ranger Talk","detail":"","price":null},{"name":"Guided tour","detail":"","price":null}],"services":[{"name":"Rock climbing","desc":null,"photo":"https://wnpa.org/sites/default/files/styles/scale_1920/public/2025-04/Rock%20climbing_mark-mcgregor-Ns8trMR4Om8-unsplash.jpg?itok=3vzmgvv8","variants":[{"label":"Standard","price":null,"optionIdx":0}]},{"name":"Wildlife viewing","desc":null,"photo":"https://wnpa.org/sites/default/files/styles/scale_1920/public/2025-03/Copy-of-High-Peaks-Trail-scaled.jpg?itok=o3B3HMfO","variants":[{"label":"Standard","price":null,"optionIdx":1}]},{"name":"Overnight stay","desc":"Saturday, July 18 Get ready for a morning of out-of-this-world fun! Young explorers will discover the wonders of dark skies and learn why protecting our night skies is important for people, wildlife, and stargazing adventures alike at the second event in our Junior Ranger Summer Film Series. At 10 AM, kids can enjoy","photo":"https://wnpa.org/sites/default/files/styles/scale_1920/public/2026-05/Elio%20Poster.jpg?itok=hZlUmOor","variants":[{"label":"Standard","price":null,"optionIdx":2}]},{"name":"Campsite","desc":"Bonita Canyon Campground is a charming, historic campground with tree cover and stunning views of the night sky. This is a popular campground with 23 sites, so please reserve far in advance. The campground has flush toilets, running water, and picnic tables. No ground fires, hook ups, showers, or dump station. Vehicle","photo":"https://wnpa.org/sites/default/files/styles/scale_1920/public/2025-02/3.1.x-VisitUs_ParkPage_CHIR_banner-1.jpg?itok=jROiO9pN","variants":[{"label":"Standard","price":null,"optionIdx":3}]},{"name":"Daily Cave Tours","desc":null,"photo":"https://wnpa.org/sites/default/files/styles/scale_1440/public/2025-02/3.1.x-VisitUs_ParkPage_CAVE_banner-1.jpg?itok=BpXcknSQ","variants":[{"label":"Standard","price":null,"optionIdx":4}]},{"name":"Drop in Ranger Talk","desc":null,"photo":"https://wnpa.org/sites/default/files/styles/scale_1440/public/2025-05/I-G-programTalk.webp?itok=O51WYzik","variants":[{"label":"Standard","price":null,"optionIdx":5}],"explain":[{"term":"Drop-in","meaning":"Pay for a single class, with no membership or package."}]},{"name":"Guided tour","desc":null,"variants":[{"label":"Standard","price":null,"optionIdx":6}]}],"includes":[],"addons":[],"gap":"Prices, hours and eligibility are not copied here yet. We will ask when you request.","blurb":"Step into history at Hubbell Trading Post National Historic Site, the oldest continuously operating trading post in the Navajo Nation. Since 1878, this historic post in northeastern Arizona has been a center of commerce and cultural exchange. Today, visitors can walk through the original trading post, browse authentic Navajo rugs and crafts, and explore the historic homestead and barn.","cover":"https://wnpa.org/sites/default/files/styles/scale_1920/public/2025-12/GRBA%20Ranger%20with%20Tour%20Group.jpg?itok=eeUgfCJa","photos":["https://wnpa.org/sites/default/files/styles/scale_1920/public/2025-12/GRBA%20Ranger%20with%20Tour%20Group.jpg?itok=eeUgfCJa","https://wnpa.org/sites/default/files/styles/scale_1920/public/2025-04/5.3-ParkVisitorExperience_Section2_AudioTours.jpg?itok=Q_9N7EZn","https://wnpa.org/sites/default/files/styles/scale_1920/public/2025-04/5.4-ParkResearch_Section1_ImageCarousel_PadreIsland-1.jpg?itok=SpSLoSu3","https://wnpa.org/sites/default/files/styles/scale_1920/public/2025-04/Big%20Room_Carlsbad%20Caverns_NPS_Eymard%20Bangcoro.jpg?itok=kN