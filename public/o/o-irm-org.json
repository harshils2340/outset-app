cket availability"],"highlights":[],"requirements":[],"groupInfo":[],"bring":[],"policies":[],"waiverUrl":"http://pinterest.com/pin/create/button/?url=https://www.irm.org/take-the-throttle/&description=Ever%20dream%20of%20being%20a%20real%20train%20engineer?%20At%20the%20Illinois%20Railway%20Museum,%20that%20dream%20can%20come%20true.%20Our%20Take%20The%20Throttle%20program%20will%20make%20you%20engineer%20for%20an%20hour.%20Live%20the%20fantasy%20of%20every%20railfan%20and%20operate%20a%20train%20at%20speed%20over%20our%20five-mile%20demonstration%20railroad.%20Ring%20the%20bell,%20blow%20the%20horn,%20wave%20to%20the%20kids,%20and%20smile%20for%20the%20camera%20during%20this%20once-in-a-lifetime%20experience!%20As%20a%20student%20engineer%20or%20motorman%20you%20will%20have%20full%20control,%20under%20the%20careful%20supervision%20and%20instruction%20of%20IRM%20crewmen.%20Or,%20if%20you%20have%20a%20railfan%20in%20the%20family,%20give%20a%20birthday%20or%20holiday%20gift%20that%20they%20will%20never%20forget!%20This%20unique%20opportunity%20is%20available%20for%20a%20donation%20of%20only%20$295%20per%20person%20for%20diesel%20equipment.%20Electric%20equipment%20is%20available%20for%20a%20donation%20of%20$200%20per%20person.%20Or%20treat%20yourself%20(or%20a%20friend%20or%20family%20member)%20to%20the%20ultimate%20railfan%20adventure:%20both%20diesel%20and%20electric!%20Space%20for%20this%20program%20is%20extremely%20limited,%20and%20advance%20reservations%20are%20essential:%20reserve%20your%20spot%20today,%20while%20space%20is%20still%20available.%20Take%20the%20Throttle%20is%20also%20available%20for%20a%20very%20limited%20number%20of%20dates%20on%20a%20steam%20engine%20at%20$600.%20Take%20the%20Throttle%20Dates%20The%20museum%E2%80%99s%20Take%20the%20Throttle%20program%20operates%20only%20on%20the%20following%20dates%20in%202026:%20Saturday,%20June%2020;%20Sunday,%20July%2026;%20Saturday,%20August%2022;%20and%20Sunday,%20September%2013%20Take%20the%20Throttle%20diesel%20trains%20depart%20at%2010:30AM,%2011:30%20AM,%2012:30%20PM,%201:30%20PM,%203:00%20PM,%20and%204:00%20PM.%20Take%20the%20Throttle%20electric%20trains%20depart%20at%2010:45%20AM,%2011:45%20AM,%2012:45%20PM,%201:45%20PM,%203:15%20PM,%20and%204:15%20PM.%20PLEASE%20NOTE:%20Each%20participant%20must%20be%20at%20least%2018%20years%20old%20and%20must%20sign%20a%20liability%20waiver.%20Please%20complete%20the%20digital%20waiver%20linked%20in%20the%20order%20confirmation%20email%20prior%20to%20your%20arrival%20at%20the%20museum.%20IRM%20will%20selected%20the%20specific%20pieces%20of%20equipment.%20All%20operations%20are%20subject%20to%20cancellation%20or%20rescheduling%20for%20mechanical,%20operational,%20or%20safety%20reasons.%20IRM%20will%20provide%20confirmation%20of%20the%20scheduled%20date%20by%20mail.%20Participants%20must%20arrive%20one%20hour%20in%20advance%20of%20their%20trip%20departure%20time.%20Please%20contact%20us%20with%20any%20questions.","hoursText":["Sat-Sun 10:00 AM - 5:00 PM"],"faq":[],"quotes":[],"contact":{"domain":"irm.org","phone":null,"street":"7000 Olson Road","city":"Union","region":"IL","postal":"60180","hours":[]}}