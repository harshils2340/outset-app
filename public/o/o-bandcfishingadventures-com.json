{"id":"o-bandcfishingadventures-com","title":"B&C Fishing Adventures","cat":"water","art":"fishing","area":"Chouteau, OK","metroId":"","src":"bandcfishingadventures.com","rating":5,"reviews":54,"specs":[],"options":[{"name":"OK Fishing Fun","detail":"","price":200},{"name":"Dive trip","detail":"","price":null},{"name":"Boat tour","detail":"","price":null}],"services":[{"name":"OK Fishing Fun","desc":"Get ready for some serious rod-bending action on this 4-hour guided fishing trip with Bob Scoggins of B & C Fishing Adventures. We'll be hitting the sweet spots on Oklahoma's lakes and rivers, targeting some of the most sought-after freshwater species in the state. Whether you're a seasoned angler or just getting your feet wet, this afternoon charter is the perfect way to scratch that fishing itch and maybe even land the catch of a lifetime. As soon as we push off, you'll feel the excitement in the air. Bob knows these waters like the back of his hand, and he'll have us on the fish in no time. We'll be going after paddlefish, blue catfish, and white bass - some of the hardest fighting fish","photo":"https://www.bandcfishingadventures.com/_next/image?url=https%3A%2F%2Fdlsmyzcs6vrg4.cloudfront.net%2Ffilters%3Astrip_exif()%2Ffit-in%2F250x250%2Fguide_websites%2F3453%2Fimages%2F1710891051635image90.png&w=1920&q=100","variants":[{"label":"Standard","price":200,"optionIdx":0}]},{"name":"Dive trip","desc":null,"photo":"https://www.bandcfishingadventures.com/_next/image?url=https%3A%2F%2Fdlsmyzcs6vrg4.cloudfront.net%2Ffilters%3Astrip_exif()%2Fusers%2F4d6e5727-7fb7-449f-81cc-53988b3d1b63%2Fimages%2Fwhitehorn-cove-deep-sea-fishing-2959.png&w=1920&q=90","variants":[{"label":"Standard","price":null,"optionIdx":1}]},{"name":"Boat tour","desc":null,"photo":"https://dlsmyzcs6vrg4.cloudfront.net/filters:strip_exif()/fit-in/250x300/users/4d6e5727-7fb7-449f-81cc-53988b3d1b63/images/fishing-catch-wagoner-oklahoma-2312.jpg","variants":[{"label":"Standard","price":null,"optionIdx":2}]}],"inc