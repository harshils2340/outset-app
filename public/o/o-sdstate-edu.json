{"id":"o-sdstate-edu","claimKey":"e6ed6ccc50ef22b335c6f6821dcb4a8821058fcd14fd641770ec11d1e3c230e0","title":"South Dakota Art Museum","cat":"play","art":"museum","area":"SD","metroId":"","src":"sdstate.edu","specs":[],"options":[{"name":"Guild, Volunteers and Docents","detail":"","price":null},{"name":"All Exhibitions","detail":"","price":null},{"name":"Student Health Clinic","detail":"","price":null},{"name":"Students playing frisbee golf","detail":"","price":null}],"services":[{"name":"Guild, Volunteers and Docents","desc":"Guild members are a valuable resource as volunteers and supporters of the museum. They maintain an active schedule of events as well as volunteer in various aspects of the museum. The South Dakota Art Museum has a variety of volunteer opportunities that are both interesting and fulfilling. Some volunteer positions interact with museum visitors while others may work behind the scenes. Whatever the job, everyone performs a service to the museum that cannot be measured in dollars and cents. Each year hundreds of school children, university students and adults from South Dakota and the region tour the museum. Trained docents lead tours specially tailored to the age and interests of each group.","photo":"https://www.sdstate.edu/sites/default/files/styles/image_promo/public/2024-07/SDAM%20Guild%20program.jpg?itok=C4WvpgPd","variants":[{"label":"Standard","price":null,"optionIdx":0}]},{"name":"All Exhibitions","desc":null,"photo":"https://www.sdstate.edu/sites/default/files/styles/sdsu_card_image/public/2024-07/SDAM%20reception%20for%20Termespheres%20exhibition.jpg?itok=Hr-I2ixj","variants":[{"label":"Standard","price":null,"optionIdx":1}]},{"name":"Student Health Clinic","desc":null,"photo":"https://www.sdstate.edu/sites/default/files/styles/sdsu_card_image/public/2023-10/1-1-Dunn_197916-2.jpg?itok=y3OBnUC_","variants":[{"label":"Standard","price":null,"optionIdx":2}]},{"name":"Students playing frisbee golf","desc":null,"photo":"https://www.sdstate.e