{"id":"o-konahistorical-org","claimKey":"17c94b5c01220291afb16da54ef3d2961004c883f6225a4af59fb3eb1246aada","title":"Kona Coffee Living History Farm","cat":"play","art":"museum","area":"Captain Cook, HI","metroId":"","src":"konahistorical.org","specs":[],"options":[{"name":"Online Exhibits","detail":"Adult","price":5}],"services":[{"name":"Online Exhibits","desc":"NOTE: the H.N.Greenwell Store Museum is currently hosting Martha Greenwell’s Mouse House Christmas Village Exhibit. Hours are posted to our social media pages. Constructed by Englishman Henry Nicholas Greenwell in 1870, the store once served the immigrant community with supplies and goods needed in the remote Kona Districts. From his headquarters here at the Greenwell Store, H.N. Greenwell amassed thousands of acres of ranch land where he and his sons helped to develop the Kona ranching industry of the late 19th century. His wife Elizabeth Caroline Greenwell ran the store in her husband’s absence and was joined as storekeeper by her daughter-in-law Maud Greenwell during the 1930s. The H.N.","photo":"https://images.squarespace-cdn.com/content/v1/5ce890e50d07640001881de0/1589426803289-IVB5UHGBKQQVDEZ83RE8/93849137_3234352256576899_4254034131660308480_o.jpg","variants":[{"label":"Adult","price":5,"optionIdx":0}]}],"includes":[],"addons":[{"name":"Each Additional Hour","detail":"","price":50}],"gap":"Prices, hours and eligibility are not copied here yet. We will ask when you request.","cover":"https://images.squarespace-cdn.com/content/v1/5ce890e50d07640001881de0/1558745976219-QIUA3FLSIIT87M34VHJR/IMG_3827.JPG?format=2500w","photos":["https://images.squarespace-cdn.com/content/v1/5ce890e50d07640001881de0/1558745976219-QIUA3FLSIIT87M34VHJR/IMG_3827.JPG?format=2500w","https://images.squarespace-cdn.com/content/v1/5ce890e50d07640001881de0/1558845901694-6BYMYUWWMUL1NSDQ3Q0H/IMG_3825.JPG","https://images.squarespace-cdn.com/content/v1/5ce890e50d07640001881de0/1590098728967-6SGP7IN92IR71AEVAF78/image-asset.jpeg","htt