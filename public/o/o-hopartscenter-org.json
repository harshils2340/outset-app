{"id":"o-hopartscenter-org","claimKey":"f38b59da1676b413ccbaa6727ee5955a054f4259a75cbaf87cad8e361f652f56","title":"Hopkinton Center for the Arts","cat":"play","art":"theatre","area":"Boston, MA","metroId":"boston","src":"hopartscenter.org","specs":[],"options":[{"name":"Membership Benefits","detail":"Individual Adult","price":75},{"name":"Take a Class","detail":"","price":null},{"name":"HCA Community Kiln Ceramics","detail":"","price":null},{"name":"Private Lessons","detail":"","price":null},{"name":"Art Exhibitions","detail":"","price":null},{"name":"Hip Hop 2","detail":"","price":null},{"name":"Facility Rentals","detail":"","price":null},{"name":"Rental","detail":"","price":null},{"name":"Rentals or Birthday Parties","detail":"","price":null}],"services":[{"name":"Take a Class","desc":null,"photo":"https://static.wixstatic.com/media/a829a6_a992687cbd7f43e090f25fb1134def3c~mv2.png/v1/fill/w_1600,h_1000,al_c,q_85/a829a6_a992687cbd7f43e090f25fb1134def3c~mv2.png","variants":[{"label":"Standard","price":null,"optionIdx":1}]},{"name":"HCA Community Kiln Ceramics","desc":null,"photo":"https://static.wixstatic.com/media/a829a6_babdb30001864f5b809ea35123eeb321~mv2.jpg/v1/fill/w_1600,h_1000,al_c,q_85/a829a6_babdb30001864f5b809ea35123eeb321~mv2.jpg","variants":[{"label":"Standard","price":null,"optionIdx":2}]},{"name":"Private Lessons","desc":"Subscribe to our newsletter and follow us on social media to receive the latest updates on classes, events, and exhibitions. There is an Annual Registration Fee of $85. This covers lessons from September 2026 to August 2027. This also includes performance fees for our three recital opportunities in December, June, and August. Families with multiple students will not pay more than $100 in annual registration fees. Students must purchase all supplies, such as music books, paints, or dance attire. HCA Insider Plus Members (and higher) are entitled to a 5% discount on all lessons and class tuition, and most ticketed events. This membership also includes extra perks, such as free or discounted","photo":"https://static.wixstatic.com/media/a829a6_466ad2bb40ed42bd8d459a088637100d~mv2.png/v1/fill/w_1600,h_1000,al_c,q_85/a829a6_466ad2bb40ed42bd8d459a088637100d~mv2.png","variants":[{"label":"Standard","price":null,"optionIdx":3}]},{"name":"Art Exhibitions","desc":null,"photo":"https://static.wixstatic.com/media/f7cda5_1ab81ae0ca9845a3ac4e97c8a7f329c7~mv2.jpg/v1/fill/w_1600,h_1000,al_c,q_85/f7cda5_1ab81ae0ca9845a3ac4e97c8a7f329c7~mv2.jpg","variants":[{"label":"Standard","price":null,"optionIdx":4}]},{"name":"Hip Hop 2","desc":"Ceramic students have the opportunity to get their hands muddy while creating everyday useful objects such as mugs, bowls, serving dishes, and other vessels as well as exploring the sculptural aspects of the medium. Directed by Hana Reilly, the ceramics studio welcomes students of all backgrounds and abilities. The Dance program, led by Desiree Reese Mottard, is known for its high level of training and welcoming environment where students are encouraged to take chances and learn. All students are embraced, whether their objectives are simply rooted in the joy of movement or in the intention to progress to a professional level. The Music Department at the HCA exists to help people of all","photo":"https://static.wixstatic.com/media/a829a6_24538e02ca8e4e98b3fd8a07960d35b1~mv2.jpg/v1/fill/w_1600,h_1000,al_c,q_85/a829a6_24538e02ca8e4e98b3fd8a07960d35b1~mv2.jpg","variants":[{"label":"Standard","price":null,"optionIdx":5}]},{"name":"Facility Rentals","desc":null,"photo":"https://static.wixstatic.com/media/f7cda5_c1dd0ef9d5f34e3090aa2a2c9bd94bdb~mv2.jpg/v1/fill/w_1600,h_1000,al_c,q_85/f7cda5_c1dd0ef9d5f34e3090aa2a2c9bd94bdb~mv2.jpg","variants":[{"label":"Standard","price":null,"optionIdx":6}]},{"name":"Rental","desc":null,"photo":"https://static.wixstatic.com/media/f7cda5_c1dd0ef9d5f34e3090aa2a2c9bd94bdb~mv2.jpg/v1/fill/w_1600,h_1000,al_c,q_85/f7cda5_c1dd0ef9d5f34e3090aa2a2c9bd94bdb~mv2.jpg",