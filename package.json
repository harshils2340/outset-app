{
  "name": "outset-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --import ./backend/node_modules/tsx/dist/loader.mjs --test \"src/lib/__tests__/*.test.ts\"",
    "build": "tsc -b && vite build && node scripts/copy-operators.mjs && tsx scripts/build-pages.mts",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "backend": "npm run dev --prefix backend",
    "backend:ingest": "npm run ingest --prefix backend",
    "backend:scrape": "npm run scrape --prefix backend",
    "backend:outreach": "npm run outreach --prefix backend",
    "backend:sync": "npm run sync --prefix backend",
    "backend:claim-index": "npm run claim-index --prefix backend",
    "backend:discover": "npm run discover --prefix backend",
    "backend:enrich": "npm run enrich --prefix backend",
    "backend:search": "npm run search --prefix backend",
    "backend:structure": "npm run structure --prefix backend",
    "backend:social": "npm run social --prefix backend",
    "backend:photos": "npm run photos --prefix backend",
    "search:eval": "node --import ./backend/node_modules/tsx/dist/loader.mjs scripts/search-eval.mts",
    "otto:eval": "node --import ./backend/node_modules/tsx/dist/loader.mjs scripts/otto-eval.mts"
  },
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.3.5"
  }
}
